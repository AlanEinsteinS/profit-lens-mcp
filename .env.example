# Copy to .env and fill in what you need. Everything is optional:
# with no variables set, the server runs on the built-in mock store.

# --- Mock data ---
# PROFIT_LENS_SEED=42
# PROFIT_LENS_AS_OF=2026-11-15

# --- Transport ---
# MCP_TRANSPORT=stdio            # stdio | http (or pass --transport http)
# HOST=127.0.0.1
# PORT=3000
# MCP_HTTP_TOKEN=                # require "Authorization: Bearer <token>" on /mcp (set this whenever HOST is not loopback)
# MCP_ALLOWED_HOSTS=             # comma-separated Host header allow-list, e.g. mcp.example.com

# --- Google Sheets (read-only model assumptions) ---
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_RANGE=Assumptions!A:B
# GOOGLE_SERVICE_ACCOUNT_JSON=   # raw service-account JSON; or use GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# --- Slack (the only write) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PROFIT_LENS_ENABLE_SLACK_WRITES=false   # must be true AND each call must pass confirm: true
